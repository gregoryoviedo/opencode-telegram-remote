# OpenCode Remote — required environment.
# Copy this file to .env and fill in your values.
# The bot reads .env automatically from the working directory or its parents.

WORKSPACE_ROOT=/Users/you/dev
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
ALLOWED_CHAT_ID=000000000

# Optional.
# OPENCODE_PORT=4096
# OPENCODE_BIN=opencode
# OPENCODE_AUTOSTART=true
# REMOTE_STATE_PATH=/Users/you/Library/Application Support/OpenCodeRemote/state.db
# TELEGRAM_API_ROOT=https://api.telegram.org
# TELEGRAM_PROXY_URL=http://127.0.0.1:8888
